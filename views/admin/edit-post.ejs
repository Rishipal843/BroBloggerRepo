<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/header", { title: "Edit Post", post: null }) %>
<body>
  <%- include("../partials/head") %>

  <div class="max-w-3xl mx-auto py-12 px-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">✏️ Edit Post</h1>

    <form action="/admin/edit-post/<%= post._id %>" method="POST" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700">Title</label>
        <input type="text" name="title" value="<%= post.title %>" required class="w-full border border-gray-300 rounded-lg px-4 py-2">
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700">Slug</label>
        <input type="text" name="slug" value="<%= post.slug %>" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Meta Description</label>
        <input type="text" name="meta_description" value="<%= post.meta_description %>" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Author</label>
        <input type="text" name="author" value="<%= post.author %>" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Category</label>
        <input type="text" name="category" value="<%= post.category %>" class="w-full border border-gray-300 rounded-lg px-4 py-2">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Tags</label>
        <input type="text" name="tags" value="<%= post.tags.join(", ") %>" class="w-full border border-gray-300 rounded-lg px-4 py-2">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Image URL</label>
        <input type="text" name="image" value="<%= post.image %>" class="w-full border border-gray-300 rounded-lg px-4 py-2">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Content</label>
        <textarea name="content" rows="8" required class="w-full border border-gray-300 rounded-lg px-4 py-2"><%= post.content %></textarea>
      </div>

      <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg">💾 Update Post</button>
    </form>
  </div>

  <%- include("../partials/footer") %>
</body>
</html>
