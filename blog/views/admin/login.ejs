<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/header", { title: "Admin Login", post: null }) %>
<body>
  <%- include("../partials/head") %>

  <div class="max-w-md mx-auto py-12 px-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">🔑 Admin Login</h1>

    <% if (error) { %>
      <p class="text-red-600 mb-4"><%= error %></p>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700">Username</label>
        <input type="text" name="username" required class="w-full border border-gray-300 rounded-lg px-4 py-2">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Password</label>
        <input type="password" name="password" required class="w-full border border-gray-300 rounded-lg px-4 py-2">
      </div>

      <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg">
        🔓 Login
      </button>
    </form>
  </div>

  <%- include("../partials/footer") %>
</body>
</html>
